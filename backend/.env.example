DATABASE_URL=postgresql://vie:vie@localhost:5432/fondos_vie
PORT=3000
NODE_ENV=development

# IA de apoyo al Comité Técnico (Google Gemini).
# Cree la clave en https://aistudio.google.com/apikey y colóquela solo aquí.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Otros modelos gratuitos: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# Respaldo automático si el modelo principal está saturado (503) o sin cuota (429).
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# AI_TIMEOUT_MS=240000

# Alternativa: proveedor compatible con OpenAI (por ejemplo, uno institucional).
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
