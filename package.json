{
  "name": "sistema-vie",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter sistema-vie-frontend --filter sistema-vie-backend run dev",
    "dev:frontend": "pnpm --filter sistema-vie-frontend dev",
    "dev:backend": "pnpm --filter sistema-vie-backend dev",
    "build": "pnpm -r run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "smoke": "node scripts/smoke-e2e.mjs",
    "baseline:api": "node scripts/baseline-flow.mjs",
    "regression:decisions": "node scripts/regression-decisions.mjs",
    "regression:completion": "node scripts/regression-completion.mjs",
    "regression:completion-ui": "node scripts/verificar-actual.mjs --ui",
    "regression:api": "node scripts/regression-api.mjs",
    "regression:ui": "node scripts/verificar-actual.mjs --ui",
    "test:fresh-schema": "node scripts/test-fresh-schema.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "baseline:ui": "node scripts/baseline-ui.mjs",
    "brand": "node scripts/build-brand-assets.mjs",
    "brand:preview": "node scripts/extract-logotec.mjs",
    "regression:merge-ian": "node scripts/regression-merge-ian.mjs",
    "regression:vie-final": "node scripts/regression-vie-final.mjs",
    "regression:investigador-final": "node scripts/regression-investigador-final.mjs",
    "regression:investigador-ajustes": "node scripts/regression-investigador-ajustes.mjs",
    "regression:vinculacion-final": "node scripts/regression-vinculacion-final.mjs",
    "test:actual": "node scripts/verificar-actual.mjs",
    "regression:consejo-profesores": "node scripts/regression-consejo-profesores.mjs",
    "regression:direccion-escuela": "node scripts/regression-direccion-escuela.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.64.1",
    "pdfjs-dist": "^6.3.289"
  }
}
