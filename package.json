{
  "name": "sistema-vie",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter sistema-vie-frontend --filter sistema-vie-backend run dev",
    "dev:frontend": "pnpm --filter sistema-vie-frontend dev",
    "dev:backend": "pnpm --filter sistema-vie-backend dev",
    "build": "pnpm -r run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "smoke": "node scripts/smoke-e2e.mjs",
    "baseline:api": "node scripts/baseline-flow.mjs",
    "baseline:ui": "node scripts/baseline-ui.mjs",
    "brand": "node scripts/build-brand-assets.mjs",
    "brand:preview": "node scripts/extract-logotec.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.64.1",
    "pdfjs-dist": "^6.3.289"
  }
}
